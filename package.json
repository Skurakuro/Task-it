{
  "name": "task-it",
  "productName": "Task-it",
  "version": "0.1.0",
  "description": "Notas adesivas que se fixam na tela e sincronizam com o celular",
  "author": "Daniel Skura",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "instalador": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "peerjs": "^1.5.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.taskit.notes",
    "productName": "Task-it",
    "copyright": "© 2026 Daniel Skura",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "renderer/**",
      "shared/**",
      "mobile/**",
      "assets/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Task-it",
      "artifactName": "Task-it-Setup-${version}.${ext}"
    }
  }
}
